{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "viewId",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "viewId": {
      "type": "string"
    },
    "example": {
      "type": "boolean"
    },
    "data": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    }
  },
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  },
  "description": "Application additionally enforces 256 KiB, depth 32, safe project-relative path/file/codePath/configPath/sourcePath fields, and rejects executable/prototype field names."
}
