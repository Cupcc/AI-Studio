{
  "name": "@ai-studio/desktop",
  "productName": "AI Developer Studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI Developer Studio desktop client (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron && node scripts/ensure-node-pty-helper.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:built": "playwright test",
    "package": "electron-vite build && electron-builder --mac --arm64 --dir",
    "package:built": "electron-builder --mac --arm64 --dir",
    "smoke:packaged": "node scripts/packaged-smoke.mjs"
  },
  "dependencies": {
    "@ai-studio/agent-adapter": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.0",
    "lowlight": "3.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "zustand": "5.0.15"
  }
}
